{
  // RIVERS no Cloudflare Workers (migração de 10/08 — a conta Vercel foi bloqueada
  // por limite/uso comercial no plano gratuito e derrubou site E motor por ~2h).
  // Roda via @opennextjs/cloudflare (adaptador oficial de Next.js pra Workers).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vammo-reserva",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-10",
  // nodejs_compat é obrigatório pro Next: o motor usa fetch/crypto/Buffer do Node.
  // global_fetch_strictly_public evita que chamadas ao próprio domínio curto-circuitem.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Identidade da versão deployada (20/08): alimenta o auto-reload da TV. O reload
  // era chaveado só na ALGO_VERSION e deploys de tela sem bump ficavam invisíveis
  // pras TVs abertas (caso TJN6F12 preso com cliente que recusou). Com o metadata,
  // TODO deploy muda a "versao" do payload e as TVs se recarregam sozinhas.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  }
}
